---
import HtmlIcon from "../icons/HtmlIcon.astro";
import CssIcon from "../icons/CssIcon.astro";
import ReactIcon from "../icons/ReactIcon.astro";
import NodeIcon from "../icons/NodeIcon.astro";
import ExpressIcon from "../icons/ExpressIcon.astro";
import MongoDBIcon from "../icons/MongoDBIcon.astro";
import StyledComponentsIcon from "../icons/StyledComponentsIcon.astro";
import TypeScriptIcon from "../icons/TypeScriptIcon.astro";
import ViteIcon from "../icons/ViteIcon.astro";

const TAGS = {
  HTML: {
    name: { en: "HTML", es: "HTML" },
    class: "bg-orange-600 text-white",
    icon: HtmlIcon,
  },
  CSS: {
    name: { en: "CSS", es: "CSS" },
    class: "bg-blue-500 text-white",
    icon: CssIcon,
  },
  REACT: {
    name: { en: "React.js", es: "React.js" },
    class: "bg-blue-600 text-white",
    icon: ReactIcon,
  },
  NODE: {
    name: { en: "Node.js", es: "Node.js" },
    class: "bg-green-600 text-white",
    icon: NodeIcon,
  },
  EXPRESS: {
    name: { en: "Express.js", es: "Express.js" },
    class: "bg-gray-800 text-white",
    icon: ExpressIcon,
  },
  MONGODB: {
    name: { en: "MongoDB", es: "MongoDB" },
    class: "bg-green-700 text-white",
    icon: MongoDBIcon,
  },
  STYLED: {
    name: { en: "StyledComponents", es: "StyledComponents" },
    class: "bg-blue-500 text-white",
    icon: StyledComponentsIcon,
  },
  TYPESCRIPT: {
    name: { en: "TypeScript", es: "TypeScript" },
    class: "bg-blue-500 text-white",
    icon: TypeScriptIcon,
  },
  VITE: {
    name: { en: "Vite", es: "Vite" },
    class: "bg-gray-800 text-white",
    icon: ViteIcon,
  },
};

const PROJECTS = [
  {
    title: {
      en: "TellMe Instant Messaging App",
      es: "Aplicación de Mensajería Instantánea TellMe",
    },
    description: {
      en: "TellMe is an instant messaging application that allows you to chat with your friends, send text messages, and share photos in real time. It features a user-friendly interface, secure authentication, and responsive design to enhance the chatting experience.",
      es: "TellMe es una aplicación de mensajería instantánea que te permite chatear con tus amigos, enviar mensajes de texto y compartir fotos en tiempo real. Cuenta con una interfaz fácil de usar, autenticación segura y un diseño responsivo para mejorar la experiencia de chat.",
    },
    link: "https://tellme-khp9.onrender.com/login",
    github: "https://github.com/drmcodes/TellMe",
    image: "/mockups/mockup-tellme-27-1.webp",
    tags: [
      TAGS.HTML,
      TAGS.CSS,
      TAGS.REACT,
      TAGS.VITE,
      TAGS.MONGODB,
      TAGS.EXPRESS,
    ],
  },
  {
    title: {
      en: "League of Legends Info App",
      es: "Aplicación de Información de League of Legends",
    },
    description: {
      en: "Application that retrieves information about champions, items, and runes in League of Legends consuming the API. It allows filtering champions by type, showing and filtering items by category, and viewing the different available runes from an official Riot Games repository.",
      es: "Aplicación que obtiene información sobre los campeones, objetos y runas de League of Legends mediante el consumo de su API. Permite filtrar los campeones por tipo, mostrar y filtrar los objetos por categoría, y ver las diferentes runas disponibles desde un repositorio oficial de Riot Games.",
    },
    link: "https://champion-forge.netlify.app/",
    github: "https://github.com/drmcodes/champion-forge",
    image: "/mockups/Champion forge mock up.png",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.VITE],
  },

  {
    title: {
      en: "Atelier Studio Website",
      es: "Atelier Studio",
    },
    description: {
      en: "Website for Atelier Studio. It showcases the artistic techniques they use, the drawing courses and classes they offer for all ages, their art gallery, and other services.",
      es: "Página web de Atelier Studio. Aquí se muestran las técnicas artísticas que emplean, los cursos y clases de dibujo que ofrecen para todas las edades, su galería de arte y otros servicios.",
    },
    link: "https://atelier-static-demo.netlify.app/",
    github: "https://github.com/drmcodes/atelier-static-demo",
    image: "/mockups/mock up atelier.png",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.REACT, TAGS.STYLED, TAGS.VITE],
  },
];

const language =
  typeof window !== "undefined"
    ? localStorage.getItem("language") || "en"
    : "en";
---

<div id="projects">
  {
    PROJECTS.map(({ title, description, tags, image, link, github }) => (
      <article class="pb-24">
        <h3 id="title" class="text-2xl font-semibold text-yellow-200/90 mb-2">
          {title[language]}
        </h3>
        <p id="description" class="text-lg mb-4 text-pretty">
          {description[language]}
        </p>
        <ul class="flex flex-wrap gap-x-2">
          {tags.map((tag) => (
            <li class="mb-2">
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
              >
                <tag.icon class="w-4 h-4" />
                {tag.name[language]}
              </span>
            </li>
          ))}
        </ul>
        <img
          class="rounded shadow-2xl shadow-white/10 pt-4"
          src={image}
          alt={`Screenshot of ${title[language]}`}
        />
        <div class="flex justify-between">
          <a
            class="rounded-full border w-[45%] my-5 border-white/10 flex justify-center items-center gap-x-2 py-1 px-2 md:py-4 md:px-4 text-xs lg:text-base bg-white/5 hover:scale-110 hover:bg-white/10 transition"
            target="_blank"
            rel="noopener noreferrer"
            href={link}
          >
            Demo
          </a>
          <a
            class="rounded-full border w-[45%] my-5 border-white/10 flex justify-center items-center gap-x-2 py-1 px-2 md:py-4 md:px-4 text-xs lg:text-base bg-white/5 hover:scale-110 hover:bg-white/10 transition"
            target="_blank"
            rel="noopener noreferrer"
            href={github}
          >
            GitHub Repo
          </a>
        </div>
      </article>
    ))
  }
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const language = localStorage.getItem("language") || "en";

    const projectContents = {
      en: [
        {
          title: "TellMe Instant Messaging App",
          description:
            "TellMe is an instant messaging application that allows you to chat with your friends, send text messages, and share photos in real time. It features a user-friendly interface, secure authentication, and responsive design to enhance the chatting experience.",
        },
        {
          title: "Champion Forge",
          description:
            "Application that retrieves information about champions, items, and runes in League of Legends via API. It allows filtering champions by type, showing and filtering items by category, and viewing the different available runes from an official Riot Games repository.",
        },

        {
          title: "Atelier Studio",
          description:
            "Website for Atelier Studio. It showcases the artistic techniques they use, the drawing courses and classes they offer for all ages, their art gallery, and other services.",
        },
      ],
      es: [
        {
          title: "Aplicación de Mensajería Instantánea TellMe",
          description:
            "TellMe es una aplicación de mensajería instantánea que te permite chatear con tus amigos, enviar mensajes de texto y compartir fotos en tiempo real. Cuenta con una interfaz fácil de usar, autenticación segura y un diseño responsivo para mejorar la experiencia de chat.",
        },
        {
          title: "Champion Forge",
          description:
            "Aplicación que obtiene información sobre los campeones, objetos y runas de League of Legends mediante el consumo de su API. Permite filtrar los campeones por tipo, mostrar y filtrar los objetos por categoría, y ver las diferentes runas disponibles desde un repositorio oficial de Riot Games.",
        },

        {
          title: "Atelier Studio",
          description:
            "Página web de Atelier Studio. Aquí se muestran las técnicas artísticas que emplean, los cursos y clases de dibujo que ofrecen para todas las edades, su galería de arte y otros servicios.",
        },
      ],
    };

    const currentContent = projectContents[language] || projectContents.en;

    const projectElements = document.querySelectorAll("#projects > article");

    projectElements.forEach((element, index) => {
      const titleElement = element.querySelector("h3");
      const descriptionElement = element.querySelector("p");

      if (currentContent[index]) {
        titleElement.innerText = currentContent[index].title;
        descriptionElement.innerText = currentContent[index].description;
      }
    });
  });
</script>
